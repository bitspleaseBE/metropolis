.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-img/
venv/
dist/
build/
output/
viewer/*.glb
viewer/*.premeshopt.glb
!viewer/characters/
!viewer/characters/*.glb
!viewer/characters/clips/
!viewer/characters/clips/*.glb
viewer/characters/*.fbx
# Mixamo source FBX (rebake via scripts/bake_player_locomotion.py). Clips ship as GLB.
assets/mixamo
assets/rocketbox
# Quaternius CC0 weapon sources (rebake via scripts/build_weapon_glbs.py).
assets/weapons
viewer/characters/players/_preview/
viewer/characters/players/_styled/
scripts/node_modules/
# Cache most OSM downloads; commit Harmonie for reproducible Pages builds.
assets/osm/*
!assets/osm/harmonie.json
assets/gtfs/
# District packages: commit 2018 OSM + facades; ignore bulky regenerated caches.
districts/*/cache/gtfs*.json
districts/*/cache/courts.json
districts/*/cache/aerial/
# Picture references: index.json is committed; thumbnails re-download via `district refs`.
districts/*/references/*/
# Review packs: LATEST.md + proofs are committed; timestamped runs are local history.
districts/*/review/2*/
# District packages ship core.glb + chunks/ + landmarks/ for Pages.
# city.glb is a byte-identical copy of core.glb from `district build` — skip it.
viewer/districts/**/city.glb
viewer/districts/**/*.premeshopt.glb
*.blend1
*.blend2
.python-version
# Antwerpen-in-3D CityJSON sectors (re-downloaded by cityview.city3d).
assets/antwerp3d/json/
# Rocketbox pack is huge — fetched locally, never committed.
assets/rocketbox/
